<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Read-only STS2 human trajectory collector for SpireFormer datasets.</Description>
    <AssemblyName>SlayTheModelDataCollector</AssemblyName>
    <RootNamespace>SlayTheModel.Sts2.DataCollector</RootNamespace>
    <Version>0.1.0</Version>
    <UserProfileDir>$([System.Environment]::GetFolderPath(System.Environment+SpecialFolder.UserProfile))</UserProfileDir>
    <Sts2ManagedDir Condition="'$(Sts2ManagedDir)' == '' and '$(STS2_GAME_DIR)' != '' and $([MSBuild]::IsOSPlatform('Windows'))">$(STS2_GAME_DIR)/data_sts2_windows_x86_64</Sts2ManagedDir>
    <Sts2ManagedDir Condition="'$(Sts2ManagedDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProgramFiles32)/Steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64</Sts2ManagedDir>
    <Sts2ManagedDir Condition="'$(Sts2ManagedDir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(UserProfileDir)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</Sts2ManagedDir>
  </PropertyGroup>

  <Target Name="ValidateSts2ManagedDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Sts2ManagedDir)/sts2.dll')"
           Text="STS2 managed assembly not found. Pass -p:Sts2ManagedDir=/path/to/the/game/managed/directory." />
    <Error Condition="!Exists('$(Sts2ManagedDir)/GodotSharp.dll')" Text="GodotSharp.dll not found in Sts2ManagedDir=$(Sts2ManagedDir)." />
    <Error Condition="!Exists('$(Sts2ManagedDir)/0Harmony.dll')" Text="0Harmony.dll not found in Sts2ManagedDir=$(Sts2ManagedDir)." />
  </Target>

  <ItemGroup>
    <!--
      The STS2 loader probes only the manifest's primary assembly. Compile the
      game-independent collector and protocol sources into this DLL so the
      installed collector has no adjacent managed dependencies.
    -->
    <Compile Include="../SlayTheModel.Collector/*.cs"
             Link="Collector/%(Filename)%(Extension)" />
    <Compile Include="../SlayTheModel.Sts2.Protocol/*.cs"
             Link="Protocol/%(Filename)%(Extension)" />

    <!-- Reuse only the pure snapshot projector; no automation controller or
         MCTS implementation is linked into the collector. -->
    <Compile Include="../SlayTheModel.Sts2.ModAdapter/CombatCaptureService.cs"
             Link="Shared/CombatCaptureService.cs" />
    <Compile Include="../SlayTheModel.Sts2.ModAdapter/RelicDisplayProjector.cs"
             Link="Shared/RelicDisplayProjector.cs" />
    <!-- CombatCaptureService contains optional debug-export helpers which
         reference this tiny reader; no Adapter controller is included. -->
    <Compile Include="../SlayTheModel.Sts2.ModAdapter/RuntimeConfiguration.cs"
             Link="Shared/RuntimeConfiguration.cs" />
    <Reference Include="sts2" HintPath="$(Sts2ManagedDir)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2ManagedDir)/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2ManagedDir)/0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
