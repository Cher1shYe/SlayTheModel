+++ b/simulator/tests/native_card_alignment.cpp
@@ -0,0 +1,170 @@
+// Differential fixtures anchored to native DLL 9cb4f1ad... (v0.111.0/41cef1ea).
+// Integer fixtures were executed against that DLL. Modifier/clone edge cases
+// additionally lock the corresponding decompiled native call sequence.
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include "sts2/battle.h"
+#include "sts2/monsters.h"
+#include "sts2/relics.h"
+using namespace sts2;
+namespace {
+int failures = 0, checks = 0;
+void check(const char *name, double actual, double expected) {
+    ++checks;
+    const bool ok = std::abs(actual - expected) < 1e-10;
+    failures += !ok;
+    std::cout << name << " actual=" << actual << " expected=" << expected
+              << (ok ? " PASS\n" : " FAIL\n");
+}
+BattleContext base() {
+    BattleContext b;
+    Card deck[20];
+    for (int i=0; i<20; ++i) deck[i]=make_card(CardId::STRIKE_IRONCLAD,false,i+1);
+    b.init(Encounter::SETUP_CEREMONIAL_BEAST_BOSS,1234,deck,20,0,500,500);
+    b.handCount=b.drawCount=b.discardCount=b.exhaustCount=0;
+    b.knownTopCount=0; b.player.energy=50;
+    b.monsters[0].hp=b.monsters[0].maxHp=10000; b.monsters[0].block=0;
+    std::memset(b.monsters[0].power,0,sizeof(b.monsters[0].power));
+    b.monsters[0].vulnerable=b.monsters[0].weak=b.monsters[0].strength=0;
+    return b;
+}
+void hand(BattleContext &b, CardId id, bool up=false) {
+    b.hand[b.handCount++]=make_card(id,up,b.require_card_uid());
+}
+void play(BattleContext &b) {
+    Action a; a.type=ActionType::PLAY_CARD; a.hand=0; a.target=0; b.step(a);
+}
+Card &discarded(BattleContext &b, CardId id) {
+    for(int i=0;i<b.discardCount;++i) if(b.discard[i].id==id) return b.discard[i];
+    throw std::runtime_error("expected discarded card missing");
+}
+void relic(BattleContext &b, RelicId id, int counter) {
+    b.relics[b.relicCount]=static_cast<int>(id); b.relicAux[b.relicCount++]=counter;
+}
+}
+int main() {
+    for (bool upgraded : {false,true}) {
+        auto b=base(); hand(b,CardId::CINDER,upgraded); hand(b,CardId::DEFEND_IRONCLAD);
+        b.draw[b.drawCount++]=make_card(CardId::STRIKE_IRONCLAD,false,b.require_card_uid());
+        play(b);
+        check(upgraded?"Cinder+ damage":"Cinder damage",10000-b.monsters[0].hp,upgraded?24:18);
+        check("Cinder exhausts remaining hand",b.handCount,0);
+        check("Cinder preserves draw",b.drawCount,1);
+        check("Cinder exhausted Defend",static_cast<int>(b.exhaust[0].id),static_cast<int>(CardId::DEFEND_IRONCLAD));
+    }
+    {
+        auto b=base(); hand(b,CardId::CINDER);
+        b.discard[b.discardCount++]=make_card(CardId::DEFEND_IRONCLAD,false,b.require_card_uid());
+        const auto counter=b.cardSelectionRng.counter; play(b);
+        check("Cinder empty hand consumes no selection RNG",b.cardSelectionRng.counter,counter);
+        check("Cinder empty hand does not shuffle",b.drawCount,0);
+        check("Cinder empty hand exhausts nothing",b.exhaustCount,0);
+    }
+    {
+        auto b=base(); hand(b,CardId::CINDER); hand(b,CardId::DEFEND_IRONCLAD);
+        b.draw[b.drawCount++]=make_card(CardId::STRIKE_IRONCLAD,false,b.require_card_uid());
+        b.add_player_power(PowerId::DARK_EMBRACE,1); play(b);
+        check("Cinder exhaust hooks draw",b.handCount,1);
+        check("Cinder hook-drawn card stays",static_cast<int>(b.hand[0].id),static_cast<int>(CardId::STRIKE_IRONCLAD));
+    }
+    {
+        auto b=base(); hand(b,CardId::ANGER);
+        auto &a=b.hand[0]; a.enchantment=EnchantmentId::SOWN; a.enchantmentAmount=8;
+        a.bonusDamage=4.5; a.freeCombat=true; a.bonusReplay=0;
+        a.costThisTurn=true; a.costForTurn=0; a.storedCost=2;
+        a.retainThisCombat=true; const auto uid=a.uid; play(b);
+        int originals=0, copies=0;
+        for (int i=0;i<b.discardCount;++i) {
+            const auto &c=b.discard[i];
+            if(c.uid==uid) { ++originals; check("Anger original enchantment used",c.enchantmentDisabled,1); }
+            else if(c.id==CardId::ANGER) {
+                ++copies;
+                check("Anger clone enchantment",static_cast<int>(c.enchantment),static_cast<int>(EnchantmentId::SOWN));
+                check("Anger clone amount",c.enchantmentAmount,8);
+                check("Anger clone has independent active enchantment",c.enchantmentDisabled,0);
+                check("Anger clone fractional damage",c.bonusDamage,4.5);
+                check("Anger clone combat cost",c.freeCombat,1);
+                check("Anger clone temporary cost",c.costThisTurn,1);
+                check("Anger clone stored cost",c.storedCost,2);
+                check("Anger clone retain",c.retainThisCombat,1);
+            }
+        }
+        check("Anger original count",originals,1); check("Anger unique clone",copies,1);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::STRIKE_IRONCLAD);
+        b.player.strength=5; play(b);
+        check("Thrash with Strength initial attack",10000-b.monsters[0].hp,18);
+        check("Thrash with Strength growth",discarded(b,CardId::THRASH).bonusDamage,11);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::BODY_SLAM);
+        b.player.block=10; play(b);
+        check("Thrash Body Slam growth",discarded(b,CardId::THRASH).bonusDamage,10);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::STRIKE_IRONCLAD);
+        b.player.weak=1; play(b);
+        const Card first=discarded(b,CardId::THRASH);
+        check("Thrash Weak fractional growth",first.bonusDamage,4.5);
+        b.discardCount=0; b.hand[b.handCount++]=first; hand(b,CardId::STRIKE_IRONCLAD);
+        const int hp=b.monsters[0].hp; play(b);
+        check("Thrash fractional base used in next attack",hp-b.monsters[0].hp,12);
+        check("Thrash fractional growth accumulates",discarded(b,CardId::THRASH).bonusDamage,9);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::STRIKE_IRONCLAD);
+        b.monsters[0].vulnerable=3; b.monsters[0].power[static_cast<int>(PowerId::SLOW)]=1;
+        b.monsters[0].slowCardsThisTurn=4; play(b);
+        check("Thrash growth has no enemy modifiers",discarded(b,CardId::THRASH).bonusDamage,6);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::BULLY);
+        b.monsters[0].vulnerable=5; play(b);
+        check("Thrash Bully has null target",discarded(b,CardId::THRASH).bonusDamage,card_var(make_card(CardId::BULLY,false,1),VarId::CALC_BASE));
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::ASHEN_STRIKE);
+        b.exhaust[b.exhaustCount++]=make_card(CardId::DEFEND_IRONCLAD,false,b.require_card_uid());
+        play(b); check("Thrash Ashen counts before exhaustion",discarded(b,CardId::THRASH).bonusDamage,9);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::PERFECTED_STRIKE);
+        play(b); check("Thrash Perfected includes selected card",discarded(b,CardId::THRASH).bonusDamage,8);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::GOLD_AXE);
+        b.cardsPlayedThisCombat=b.cardsFinishedThisCombat=3; play(b);
+        check("Thrash Gold Axe counts completed plays",discarded(b,CardId::THRASH).bonusDamage,3);
+        check("Thrash increments finished history afterwards",b.cardsFinishedThisCombat,4);
+    }
+    for(int counter : {8,9}) {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::STRIKE_IRONCLAD);
+        relic(b,RelicId::PEN_NIB,counter); play(b);
+        check(counter==8?"Thrash ninth attack hand-preview Pen Nib":"Thrash tenth attack does not double selected card",
+              discarded(b,CardId::THRASH).bonusDamage,counter==8?12:6);
+    }
+    for(int stacks : {1,2}) {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::STRIKE_IRONCLAD);
+        b.add_player_power(PowerId::GIGANTIFICATION,stacks); play(b);
+        check("Thrash growth sees Gigantification after attack",discarded(b,CardId::THRASH).bonusDamage,stacks==1?6:18);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::DEFEND_IRONCLAD);
+        const auto counter=b.cardSelectionRng.counter; play(b);
+        check("Thrash no attacks consumes no RNG",b.cardSelectionRng.counter,counter);
+        check("Thrash no attacks grows zero",discarded(b,CardId::THRASH).bonusDamage,0);
+    }
+    {
+        auto b=base(); hand(b,CardId::THRASH); hand(b,CardId::STRIKE_IRONCLAD); hand(b,CardId::BASH);
+        auto expected=b.cardSelectionRng;
+        const int chosen=expected.next_int(0,1);
+        play(b);
+        check("Thrash consumes one native selection draw",b.cardSelectionRng.counter,expected.counter);
+        check("Thrash picks randomized candidate",static_cast<int>(b.exhaust[0].id),
+              static_cast<int>(chosen==0?CardId::STRIKE_IRONCLAD:CardId::BASH));
+    }
+    std::cout << checks << " checks, " << failures << " failures\n";
+    return failures?1:0;
+}
diff --git a/simulator/tests/native_rng_contract.cpp b/simulator/tests/native_rng_contract.cpp
new file mode 100644
index 0000000..565f6f0
--- /dev/null
+++ b/simulator/tests/native_rng_contract.cpp
@@ -0,0 +1,115 @@
+// Math oracle: actual native v0.111.0/41cef1ea DLL, not simulator-generated goldens.
+#include "sts2/common.h"
+#include "../json/include/nlohmann/json.hpp"
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+
+using nlohmann::json;
+using sts2::Rng;
+
+static void require(bool condition, const std::string &label) {
+    if (!condition) throw std::runtime_error(label);
+}
+static void verify_state(const Rng &rng, const json &state, const std::string &label) {
+    require(rng.counter == state.at("counter").get<std::int32_t>(), label + ": counter");
+    require(rng.state() == state.at("words").get<std::array<std::uint64_t, 4>>(), label + ": words");
+    require(rng.valid_snapshot_state(), label + ": valid state");
+    Rng restored;
+    restored.restore_state(rng.state(), rng.counter);
+    Rng copy = rng;
+    for (int i = 0; i < 3; ++i)
+        require(copy.next_unsigned_long() == restored.next_unsigned_long(), label + ": restore continuation");
+}
+static json execute(Rng &rng, const json &step) {
+    const auto op = step.at("op").get<std::string>();
+    const auto &p = step.at("parameters");
+    if (op == "int") return rng.next_int_exclusive(p.at(0).get<int>());
+    if (op == "range") return rng.next_int_range(p.at(0).get<int>(), p.at(1).get<int>());
+    if (op == "bool") return rng.next_bool();
+    if (op == "gaussian") return rng.next_gaussian_int(p.at(0).get<int>(),p.at(1).get<int>(),p.at(2).get<int>(),p.at(3).get<int>());
+    if (op == "ulong") return rng.next_unsigned_long();
+    if (op == "float_bits") {
+        const float value = rng.next_float(p.at(0).get<float>(), p.at(1).get<float>());
+        std::uint32_t bits; std::memcpy(&bits, &value, sizeof(bits)); return bits;
+    }
+    if (op == "double_bits" || op == "double_range_bits") {
+        const double value = op == "double_bits" ? rng.next_double() :
+            rng.next_double(p.at(0).get<double>(),p.at(1).get<double>());
+        std::uint64_t bits; std::memcpy(&bits, &value, sizeof(bits)); return bits;
+    }
+    throw std::runtime_error("Unknown native fixture operation: " + op);
+}
+int main(int argc, char **argv) {
+    const auto fixture = argc > 1 ? std::filesystem::path(argv[1]) :
+        std::filesystem::path(__FILE__).parent_path() / "fixtures/native_rng_41cef1ea.json";
+    std::ifstream input(fixture);
+    require(bool(input), "Missing native RNG fixture: " + fixture.string());
+    const json data = json::parse(input);
+    require(data.at("oracle_dll_sha256") == "9cb4f1ad8c9f284aa8fec3122ffd6d780bbf543d875c817abdd12ff63fbf12b4", "Native oracle identity");
+    for (const auto &test : data.at("hashes")) {
+        const auto text = test.at("text").get<std::string>();
+        require(Rng::deterministic_hash_code(std::string_view(text)) == test.at("hash").get<std::uint64_t>(), "xxHash64 UTF-8 vector");
+    }
+    for (const auto &test : data.at("canonical")) {
+        const auto canonical = Rng::canonicalize_seed(test.at("text").get<std::string>());
+        require(canonical == test.at("canonical").get<std::string>(), "Native ASCII seed canonicalization");
+        require(Rng::deterministic_hash_code(std::string_view(canonical)) == test.at("hash").get<std::uint64_t>(), "Canonical seed hash");
+    }
+    int checked = 0;
+    for (const auto &test : data.at("vectors")) {
+        const auto seed = test.at("seed").get<std::uint64_t>();
+        Rng rng(seed);
+        verify_state(rng, test.at("initial"), "initial seed " + std::to_string(seed));
+        for (const auto &step : test.at("steps")) {
+            const auto label = "seed " + std::to_string(seed) + ", step " + std::to_string(checked);
+            require(execute(rng, step) == step.at("value"), label + ": output " + step.at("op").get<std::string>());
+            verify_state(rng, step.at("state"), label);
+            ++checked;
+        }
+    }
+    for (const auto &test : data.at("oldRegression")) {
+        Rng rng(0);
+        int result;
+        if (test.at("op") == "long_int") {
+            for (int i = 0; i < 155215; ++i) rng.next_int_exclusive(100);
+            result = rng.next_int_exclusive(100);
+        } else result = rng.next_gaussian_int(100, 10, 0, 200);
+        require(result == test.at("value").get<int>(), "Long/Gaussian native vector");
+        verify_state(rng, test.at("state"), "Long/Gaussian state");
+        require(rng.next_int_exclusive(100) == test.at("next100").get<int>(), "Long/Gaussian next draw");
+    }
+    {
+        Rng rng(22), original = rng;
+        bool threw = false;
+        try { rng.next_int_exclusive(0); } catch (const std::invalid_argument &) { threw = true; }
+        require(threw && rng.counter == 1 && rng.state() == original.state(), "Native max-only invalid bound counter");
+        threw = false;
+        try { rng.next_int_range(1, 1); } catch (const std::invalid_argument &) { threw = true; }
+        require(threw && rng.counter == 1 && rng.state() == original.state(), "Native two-bound validation before counter");
+        rng.restore_state(original.state(), std::numeric_limits<std::int32_t>::max());
+        rng.next_double();
+        require(rng.counter == std::numeric_limits<std::int32_t>::min(), "Defined native int32 counter wrap");
+        require(rng.valid_snapshot_state(), "Counter wrap does not invalidate seeded state");
+        threw = false;
+        try { rng.restore_state({}, 0); } catch (const std::invalid_argument &) { threw = true; }
+        require(threw, "Reject impossible all-zero seeded state");
+        threw = false;
+        try { Rng::canonicalize_seed("\xc3\xa9"); } catch (const std::invalid_argument &) { threw = true; }
+        require(threw, "Unsupported Unicode canonicalization is explicit");
+    }
+    {
+        Rng high(0x100000016ull), low(22);
+        require(high.state() != low.state(), "High seed bits preserved");
+        int ascending[] = {0,1,2,3}, descending[] = {3,2,1,0};
+        std::sort(descending, descending + 4);
+        Rng a(22), b(22);
+        a.shuffle(ascending, 4); b.shuffle(descending, 4);
+        const int expected[] = {1,2,0,3}; // actual DLL StableShuffle fixture
+        require(std::equal(ascending, ascending+4, expected) &&
+                std::equal(descending, descending+4, expected), "Native stable/unstable integer shuffle");
+    }
+    std::cout << "native RNG contract: " << checked << " mixed operations, hashes, states and edge cases passed\n";
+}
diff --git a/simulator/tests/native_run_alignment.cpp b/simulator/tests/native_run_alignment.cpp
new file mode 100644
index 0000000..fd7e451
--- /dev/null
+++ b/simulator/tests/native_run_alignment.cpp
@@ -0,0 +1,147 @@
+// Native oracle: ../../native-run-fixtures/results.json, DLL 9cb4f1ad...
+// Fixtures use the same permanent deck order and reset only the Niche RNG.
+#include "sts2/run.h"
+#include "sts2/card_candidates.h"
+#include "sts2/relics.h"
+#include <cmath>
+#include <iostream>
+#include <set>
+using namespace sts2;
+namespace {
+int checks=0, failures=0;
+void check(const char *name, bool result) {
+    ++checks; failures += !result;
+    std::cout << name << (result?" PASS\n":" FAIL\n");
+}
+RunContext base(std::uint64_t seed=42) {
+    RunContext r; r.init(147,0); r.screen=RunScreen::SHOP;
+    r.deckCount=0; r.hp=50; r.maxHp=80;
+    for (CardId id:{CardId::STRIKE_IRONCLAD,CardId::DEFEND_IRONCLAD,CardId::BASH,
+                    CardId::ANGER,CardId::POMMEL_STRIKE,CardId::IRON_WAVE})
+        r.deck[r.deckCount++]=r.make_run_card(id,false);
+    r.runRng[RNG_NICHE]=Rng(seed);
+    return r;
+}
+bool choose(RunContext &r,std::initializer_list<int> selected) {
+    for (int i:selected) if(!r.step({RunActionType::SELECT_GRID_CARD,i})) return false;
+    return r.step({RunActionType::CONFIRM_GRID_CARDS,0});
+}
+bool same_cards(const RunContext&r,std::initializer_list<CardId> ids) {
+    if(r.deckCount!=static_cast<int>(ids.size())) return false;
+    int i=0; for (CardId id:ids) if(r.deck[i++].id!=id) return false;
+    return true;
+}
+}
+int main() {
+    const std::uint64_t seeds[]={0,42,987654321};
+    const int upgrades[3][2]={{1,4},{0,4},{3,5}};
+    const int swift[3][4]={{0,1,2,4},{2,3,4,5},{0,1,2,3}};
+    for(int k=0;k<3;++k) {
+        auto m=base(seeds[k]); check("Mushroom obtain",m.add_relic(RelicId::FRAGRANT_MUSHROOM));
+        check("Mushroom damage15",m.hp==35);
+        bool exact=true; for(int i=0;i<6;++i)
+            exact &= m.deck[i].upgraded==(i==upgrades[k][0]||i==upgrades[k][1]);
+        check("Mushroom native exact upgraded identities",exact);
+        check("Mushroom native RNG counter",m.runRng[RNG_NICHE].counter==5);
+        auto b=base(seeds[k]); check("Bracelet obtain",b.add_relic(RelicId::BEAUTIFUL_BRACELET));
+        exact=true; for(int i=0;i<6;++i) {
+            bool enchanted=false; for(int j:swift[k]) enchanted|=i==j;
+            exact &= b.deck[i].enchantment==(enchanted?EnchantmentId::SWIFT:EnchantmentId::NONE);
+            if(enchanted) exact &= b.deck[i].enchantmentAmount==2;
+        }
+        check("Bracelet native exact enchanted identities and amount",exact);
+        check("Bracelet native RNG counter",b.runRng[RNG_NICHE].counter==5);
+    }
+    {
+        auto r=base(); const auto uid=r.deck[2].uid;
+        check("PreciseScissors obtains pending choice",r.add_relic(RelicId::PRECISE_SCISSORS)&&r.cardGrid.kind==6);
+        check("Choice leaves deck untouched",r.deckCount==6&&r.deck[2].uid==uid);
+        check("Premature confirm rejected",!r.step({RunActionType::CONFIRM_GRID_CARDS,0}));
+        check("Selection preview",r.step({RunActionType::SELECT_GRID_CARD,2})&&r.cardGrid.preview&&r.deckCount==6);
+        RunContext restored; check("Selection snapshot restore",RunContext::restore(r.serialize(),restored));
+        check("Cancel leaves deck and resets selection",r.step({RunActionType::CANCEL_GRID_PREVIEW,0})&&r.deckCount==6&&!r.cardGrid.selectedCount);
+        check("Scissors chosen deletion",choose(r,{2})&&same_cards(r,{CardId::STRIKE_IRONCLAD,CardId::DEFEND_IRONCLAD,
+            CardId::ANGER,CardId::POMMEL_STRIKE,CardId::IRON_WAVE}));
+        check("Scissors no randomness",r.runRng[RNG_NICHE].counter==0);
+    }
+    {
+        auto r=base(); check("EmptyCage chosen reverse-index deletion",r.add_relic(RelicId::EMPTY_CAGE)&&choose(r,{4,0})&&
+            same_cards(r,{CardId::DEFEND_IRONCLAD,CardId::BASH,CardId::ANGER,CardId::IRON_WAVE}));
+    }
+    {
+        auto r=base(); check("PreservedFog selected deletion then curse",r.add_relic(RelicId::PRESERVED_FOG)&&choose(r,{4,0,2})&&
+            same_cards(r,{CardId::DEFEND_IRONCLAD,CardId::ANGER,CardId::IRON_WAVE,CardId::FOLLY}));
+        check("PreservedFog no randomness",r.runRng[RNG_NICHE].counter==0);
+    }
+    for(bool book:{false,true}) {
+        auto r=base(); r.hp=30;
+        if(book) {check("Book obtain",r.add_relic(RelicId::BOOK_OF_FIVE_RINGS));r.cardsAdded=4;}
+        check("Astrolabe obtains pending choice",r.add_relic(RelicId::ASTROLABE)&&r.cardGrid.kind==8);
+        check("Astrolabe chosen transform exact native order",choose(r,{4,0,2})&&same_cards(r,{CardId::DEFEND_IRONCLAD,
+            CardId::ANGER,CardId::IRON_WAVE,CardId::BLOOD_WALL,CardId::FIGHT_ME,CardId::PRIMAL_FORCE}));
+        bool upgraded=true; for(int i=0;i<6;++i) upgraded&=r.deck[i].upgraded==(i>=3);
+        check("Astrolabe upgrades only replacements",upgraded);
+        check("Astrolabe native RNG counter",r.runRng[RNG_NICHE].counter==3);
+        if(book) check("Book native heal20 and per-card count",r.hp==50&&r.cardsAdded==7);
+    }
+    {
+        auto r=base();r.hp=15;
+        check("Lethal Mushroom obtains",r.add_relic(RelicId::FRAGRANT_MUSHROOM));
+        check("Lethal Mushroom terminal",r.hp==0&&r.screen==RunScreen::RUN_OVER&&!r.won);
+        bool plain=true;for(int i=0;i<6;++i)plain&=!r.deck[i].upgraded;
+        check("Lethal Mushroom native suppresses upgrades",plain);
+        check("Lethal Mushroom still consumes RNG",r.runRng[RNG_NICHE].counter==5);
+        r.finish_room();check("finish_room cannot revive dead run",r.is_over());
+    }
+    {
+        auto r=base();r.hp=16;
+        check("Shears damage deferred until confirmation",r.add_relic(RelicId::PRECARIOUS_SHEARS)&&r.hp==16);
+        check("Shears removes first then dies",choose(r,{4,0})&&r.deckCount==4&&r.hp==0&&r.is_over());
+        r.finish_room();check("Shears death persists through room finish",r.is_over());
+    }
+    {
+        auto r=base();r.hp=16;r.add_relic(RelicId::TUNGSTEN_ROD);
+        check("Shears respects Tungsten",r.add_relic(RelicId::PRECARIOUS_SHEARS)&&choose(r,{4,0})&&r.hp==1&&!r.is_over());
+    }
+    {
+        auto r=base();r.hp=16;r.add_relic(RelicId::LIZARD_TAIL);r.add_potion(PotionId::FAIRY_IN_ABOTTLE);
+        check("Shears fairy revives first",r.add_relic(RelicId::PRECARIOUS_SHEARS)&&choose(r,{4,0})&&r.hp==24&&r.potionCount==0);
+        bool unused=false;for(int i=0;i<r.relicCount;++i)if(r.relics[i]==static_cast<int>(RelicId::LIZARD_TAIL))unused=r.relicAux[i]==0;
+        check("Fairy leaves LizardTail unused",unused);
+        run_take_noncombat_damage(r,24);check("LizardTail revives next",r.hp==40&&run_has_relic(r,RelicId::LIZARD_TAIL));
+        run_take_noncombat_damage(r,40);check("LizardTail cannot revive twice",r.hp==0&&r.is_over());
+    }
+    {
+        auto r=base();r.deckCount=1;r.deck[0]=r.make_run_card(CardId::FOLLY,false);
+        check("No eligible removal still applies Shears damage",r.add_relic(RelicId::PRECARIOUS_SHEARS)&&r.cardGrid.kind==0&&r.hp==34&&r.deckCount==1);
+        check("No eligible transform skips grid",r.add_relic(RelicId::ASTROLABE)&&r.cardGrid.kind==0&&r.deckCount==1);
+    }
+    {
+        auto r=base();r.add_relic(RelicId::BING_BONG);
+        while(r.deckCount<MAX_DECK-2)r.deck[r.deckCount++]=r.make_run_card(CardId::STRIKE_IRONCLAD,false);
+        check("Astrolabe capacity rejected before deadlocked grid",!r.add_relic(RelicId::ASTROLABE)&&!r.cardGrid.kind&&!run_has_relic(r,RelicId::ASTROLABE));
+    }
+    {
+        auto r=base();r.deckCount=0;
+        while(r.deckCount<MAX_DECK)r.deck[r.deckCount++]=r.make_run_card(CardId::FOLLY,false);
+        check("PreservedFog capacity rejected before curse overflow",!r.add_relic(RelicId::PRESERVED_FOG)&&!r.cardGrid.kind&&!run_has_relic(r,RelicId::PRESERVED_FOG));
+    }
+    {
+        auto r=base(); r.deckCount=2; r.add_relic(RelicId::ASTROLABE);
+        r.cardGrid.minSelect=r.cardGrid.maxSelect=3;
+        RunContext out;
+        check("Impossible pending selection rejected on restore",!RunContext::restore(r.serialize(),out));
+    }
+    {
+        auto r=base();
+        while(r.deckCount<MAX_DECK-2)r.deck[r.deckCount++]=r.make_run_card(CardId::STRIKE_IRONCLAD,false);
+        r.add_relic(RelicId::ASTROLABE);
+        // Corrupt the state with a new duplication hook while the selector is
+        // suspended. It must not restore into an unfinishable mandatory grid.
+        r.add_relic(RelicId::BING_BONG);
+        RunContext out;
+        check("Pending transform capacity revalidated on restore",!RunContext::restore(r.serialize(),out));
+    }
+    std::cout<<"native run alignment: "<<checks<<" checks, "<<failures<<" failures\n";
+    return failures?1:0;
+}
diff --git a/simulator/tests/native_seed_integration.cpp b/simulator/tests/native_seed_integration.cpp
new file mode 100644
index 0000000..7e71427
--- /dev/null
+++ b/simulator/tests/native_seed_integration.cpp
@@ -0,0 +1,51 @@
+// Seed plumbing and snapshot compatibility; not a full-run native parity claim.
+#include "sts2/run.h"
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <type_traits>
+
+using namespace sts2;
+static void require(bool value, const char *label) { if (!value) throw std::runtime_error(label); }
+static bool same_rng(const Rng &a, const Rng &b) {
+    return a.counter == b.counter && a.state() == b.state();
+}
+static int event_id(const char *name) {
+    for (int i = 0; i < event_count(); ++i) {
+        const EventInfo *info = event_info(i);
+        if (info && std::strcmp(info->name, name) == 0) return i;
+    }
+    throw std::runtime_error("Missing event fixture");
+}
+int main() {
+    static_assert(std::is_trivially_copyable<Rng>::value, "RNG must remain snapshot-copyable");
+    static_assert(std::is_trivially_copyable<RunContext>::value, "RunContext snapshot is a POD image");
+    auto raw = std::make_unique<RunContext>();
+    auto text = std::make_unique<RunContext>();
+    auto wide = std::make_unique<RunContext>();
+    raw->init(22, 0);
+    text->init_seed(" 22 ", 0);
+    wide->init(0x100000016ull, 0);
+    require(raw->seed == 22 && wide->seed == 0x100000016ull, "raw uint64 seed identity");
+    require(text->seed == 1884361412985708340ull, "native hash of game seed 22");
+    require(raw->seed != text->seed, "raw seed does not get implicitly hashed");
+    require(same_rng(wide->runRng[RNG_SHUFFLE], Rng(wide->seed, "shuffle")), "64-bit named shuffle stream");
+    require(same_rng(wide->playerRng[PRNG_SHOPS], Rng(wide->seed, "shops")), "single-player slot zero shops");
+    require(!same_rng(wide->runRng[RNG_SHUFFLE], raw->runRng[RNG_SHUFFLE]), "no high seed truncation");
+    event_begin(*wide, event_id("TABLET_OF_TRUTH"), false);
+    require(same_rng(wide->eventRng, Rng(wide->seed, "TABLET_OF_TRUTH")), "single-player event slot zero");
+    event_begin(*wide, event_id("DENSE_VEGETATION"), false);
+    require(same_rng(wide->eventRng, Rng(wide->seed, "DENSE_VEGETATION")), "shared event stream");
+    auto restored = std::make_unique<RunContext>();
+    const auto snapshot = text->serialize();
+    require(static_cast<unsigned char>(snapshot[4]) == 5, "snapshot version 5");
+    require(RunContext::restore(snapshot, *restored), "restore native RNG snapshot");
+    require(restored->seed == text->seed, "snapshot preserves 64-bit seed");
+    for (int stream=0; stream<RNG_COUNT; ++stream)
+        require(same_rng(restored->runRng[stream], text->runRng[stream]), "snapshot preserves every run stream");
+    auto old = snapshot; old[4] = 4;
+    const auto before = restored->serialize();
+    require(!RunContext::restore(old, *restored), "reject snapshot version 4");
+    require(restored->serialize() == before, "rejected snapshot leaves destination unchanged");
+    std::cout << "native seed integration: raw/string/high bits/streams/snapshot passed\n";
+}
