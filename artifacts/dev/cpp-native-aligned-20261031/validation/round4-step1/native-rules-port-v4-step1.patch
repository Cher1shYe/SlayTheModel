+    for(int i=1;i<static_cast<int>(CardId::COUNT);++i)
+        if(name==card_key(static_cast<CardId>(i)))return static_cast<CardId>(i);
+    assert(false);return CardId::INVALID;
+}
+int fixture_cost(const json &v,const char *key) {
+    // The oracle's Cost helper marks negative unplayable cost as -2 to
+    // distinguish it from X. C++ keeps native -1 for both and uses card flags.
+    const int cost=v[key];
+    if(cost==-2) {assert(v["unplayable"]==true);return -1;}
+    return cost;
+}
+void check_card(const Card &c,const json &v) {
+    assert(c.id==fixture_card(v["card"].get<std::string>()));
+    assert(c.upgraded==v["upgraded"]);
+    const int expectedCost=fixture_cost(v,"cost");
+    if(card_cost(c)!=expectedCost)
+        std::cerr<<card_key(c.id)<<" upgraded="<<c.upgraded<<" cost="<<card_cost(c)
+                 <<" native="<<expectedCost<<"\n";
+    assert(card_cost(c)==expectedCost);
+    assert(std::abs(card_base_damage(c)-v["damage"].get<double>())<1e-9);
+    assert(card_has(c,CF_RETAIN)==v["retain"]);
+    assert((card_has(c,CF_ETHEREAL)||c.etherealThisCombat)==v["ethereal"]);
+    assert(card_has(c,CF_EXHAUST)==v["exhaust"]);
+    assert(card_has(c,CF_UNPLAYABLE)==v["unplayable"]);
+    assert(c.replay+c.bonusReplay==v["replay"]);
+    if(v["enchantment"].is_null())assert(c.enchantment==EnchantmentId::NONE);
+    else {
+        const std::string enchant=v["enchantment"];
+        assert(c.enchantment==(enchant=="STEADY"?EnchantmentId::STEADY:EnchantmentId::VIGOROUS));
+        assert(c.enchantmentAmount==v["enchantmentAmount"]);
+        assert(c.enchantmentDisabled==(v["enchantmentStatus"]=="Disabled"));
+    }
+}
+int event_id(const char *name) {
+    for(int i=0;i<event_count();++i)if(!std::strcmp(event_info(i)->name,name))return i;
+    assert(false);return -1;
+}
+int main() {
+    const auto path=std::filesystem::path(__FILE__).parent_path().parent_path().parent_path()
+        /"native-round4-step1-downgrade-fixtures/results.json";
+    std::ifstream input(path);json fixture;input>>fixture;
+    assert(fixture["status"]=="completed");
+    assert(fixture["gameAssemblySha256"]=="9cb4f1ad8c9f284aa8fec3122ffd6d780bbf543d875c817abdd12ff63fbf12b4");
+    assert(fixture["gameSceneLoaded"]==false);
+    int cases=0;
+    for(const auto &row:fixture["results"]) {
+        const std::string test=row["test"];
+        if(test=="direct") {
+            Card c=make_card(fixture_card(row["card"]),false,123);
+            if(card_upgradable(c))card_apply_upgrade(c);
+            const std::string modifier=row["modifier"];
+            if(modifier=="turn0")card_set_turn_cost(c,0);
+            if(modifier=="turn1")card_set_turn_cost(c,1);
+            if(modifier=="cap1")c.combatCostCap=1;
+            if(modifier=="free0")c.freeCombat=true;
+            if(modifier=="keywords"){c.retainThisCombat=true;c.etherealThisCombat=true;}
+            if(modifier=="steady")assert(card_apply_enchantment(c,EnchantmentId::STEADY,1));
+            if(modifier=="vigorous")assert(card_apply_enchantment(c,EnchantmentId::VIGOROUS,3));
+            if(modifier=="replay")c.replay=2;
+            if(modifier=="growth")c.bonusDamage=c.id==CardId::THRASH?4.5:5;
+            check_card(c,row["before"]);
+            card_apply_downgrade(c);
+            assert(c.uid==123&&row["sameInstance"]==true);
+            assert(c.storedCost==fixture_cost(row["after"],"baseCost"));
+            check_card(c,row["after"]);
+            card_restore_cost(c);check_card(c,row["afterTurn"]);
+        } else {
+            RunContext r;r.init(42,0);r.deckCount=0;
+            for(const auto &entry:row["before"]) {
+                Card c=r.make_run_card(fixture_card(entry["card"]),entry["upgraded"]);
+                if(!entry["enchantment"].is_null())assert(card_apply_enchantment(c,EnchantmentId::STEADY,entry["enchantmentAmount"]));
+                c.replay=entry["replay"];r.deck[r.deckCount++]=c;
+            }
+            const bool reflections=test=="reflections";
+            event_begin(r,event_id(reflections?"REFLECTIONS":"WELCOME_TO_WONGOS"),false);
+            // Oracle likewise seeds after BeginEvent: leave/touch branch RNG only.
+            r.eventRng=Rng(row["seed"].get<std::uint64_t>());
+            std::uint16_t uids[MAX_DECK];for(int i=0;i<r.deckCount;++i)uids[i]=r.deck[i].uid;
+            assert(r.step({RunActionType::EVENT_CHOICE,reflections?0:3}));
+            assert(r.screen==RunScreen::MAP&&r.eventId==-1&&row["finished"]==true);
+            assert(r.eventRng.counter==row["rngCounter"]);
+            assert(row["sameInstances"]==true&&r.deckCount==static_cast<int>(row["after"].size()));
+            for(int i=0;i<r.deckCount;++i) {
+                assert(r.deck[i].uid==uids[i]);check_card(r.deck[i],row["after"][i]);
+                assert(r.deck[i].storedCost==fixture_cost(row["after"][i],"baseCost"));
+            }
+            RunContext restored;assert(RunContext::restore(r.serialize(),restored));
+            for(int i=0;i<restored.deckCount;++i)check_card(restored.deck[i],row["after"][i]);
+        }
+        ++cases;
+    }
+    assert(cases==28);
+    // Saved per-instance fields survive a downgrade even if they do not alter
+    // base card text; they must not be erased by replacing the Card wholesale.
+    Card c=make_card(CardId::STRIKE_IRONCLAD,true,999);
+    c.galvanized=4;c.guiltyCombatsSeen=3;c.bonusReplay=2;
+    assert(card_apply_enchantment(c,EnchantmentId::VIGOROUS,2));c.enchantmentDisabled=true;
+    card_apply_downgrade(c);
+    assert(c.uid==999&&c.galvanized==4&&c.guiltyCombatsSeen==3&&c.bonusReplay==2);
+    assert(c.enchantment==EnchantmentId::VIGOROUS&&c.enchantmentAmount==2&&c.enchantmentDisabled);
+    std::cout<<"native step1 downgrade: "<<cases<<" DLL cases plus state/snapshot checks passed\n";
+}
diff --git a/simulator/tests/native_step1_relic_replace.cpp b/simulator/tests/native_step1_relic_replace.cpp
new file mode 100644
--- /dev/null
+++ b/simulator/tests/native_step1_relic_replace.cpp
@@ -0,0 +1,146 @@
+#include "sts2/run.h"
+#include "sts2/relics.h"
+#include "sts2/relic_raw_rarity.h"
+
+#include <algorithm>
+#include <iostream>
+#include <memory>
+#include <vector>
+
+using namespace sts2;
+namespace {
+int checks = 0, failures = 0;
+void check(const char *name, bool ok) {
+    ++checks;
+    failures += !ok;
+    if (!ok) std::cerr << name << " FAIL\n";
+}
+std::unique_ptr<RunContext> base() {
+    auto r = std::make_unique<RunContext>();
+    r->init(147, 0);
+    r->screen = RunScreen::SHOP;
+    r->relicCount = 0;
+    std::fill(std::begin(r->relics), std::end(r->relics), 0);
+    std::fill(std::begin(r->relicAux), std::end(r->relicAux), 0);
+    r->hp = r->maxHp = 80;
+    return r;
+}
+struct NativeRelicReplacementCase {
+    const char *name;
+    RelicId before[4];
+    int beforeAux[4];
+    RelicId after[5];
+    int afterAux[5];
+};
+#include "../../native-round4-step1-relic-fixtures/replacement_cases.inc"
+bool bag_contains(const RelicBagState &bag, RelicId id) {
+    for (int slot = 0; slot < RELIC_BAG_SLOTS; ++slot)
+        for (int i = 0; i < bag.counts[slot]; ++i)
+            if (bag.entries[slot][i] == static_cast<int>(id)) return true;
+    return false;
+}
+}
+
+int main() {
+    for (const auto &fixture : nativeReplacementCases) {
+        auto owned = base(); auto &r = *owned;
+        r.relicCount = 4;
+        for (int i = 0; i < 4; ++i) {
+            r.relics[i] = static_cast<int>(fixture.before[i]);
+            r.relicAux[i] = fixture.beforeAux[i];
+            if (relic_raw_rarity(fixture.before[i]) == static_cast<int>(RelicRawRarity::STARTER))
+                r.relicAux[i] = 91; // synthetic stale state must not survive replacement
+        }
+        r.relicAux[4] = 89; // a fresh Touch must not inherit an unused slot's counter
+        std::uint64_t runCounters[RNG_COUNT], playerCounters[PRNG_COUNT];
+        for (int i = 0; i < RNG_COUNT; ++i) runCounters[i] = r.runRng[i].counter;
+        for (int i = 0; i < PRNG_COUNT; ++i) playerCounters[i] = r.playerRng[i].counter;
+        check(fixture.name, r.add_relic(RelicId::TOUCH_OF_OROBAS));
+        check("Touch appends only itself", r.relicCount == 5);
+        for (int i = 0; i < 5; ++i) {
+            check("Native ordered replacement identity", r.relics[i] == static_cast<int>(fixture.after[i]));
+            check("Native sibling counters and new state", r.relicAux[i] == fixture.afterAux[i]);
+        }
+        for (int i = 0; i < RNG_COUNT; ++i) check("No run RNG consumed", r.runRng[i].counter == runCounters[i]);
+        for (int i = 0; i < PRNG_COUNT; ++i) check("No player RNG consumed", r.playerRng[i].counter == playerCounters[i]);
+        check("Ordinary starter refinement does not change HP", r.hp == 80 && r.maxHp == 80);
+
+        auto clone = std::make_unique<RunContext>(r);
+        clone->relicAux[0] += 1;
+        check("Clone relic counters are independent", clone->relicAux[0] == r.relicAux[0] + 1);
+        auto restored = std::make_unique<RunContext>();
+        check("Replacement snapshot restores", RunContext::restore(r.serialize(), *restored));
+        check("Replacement snapshot preserves state", restored->serialize() == r.serialize());
+    }
+    {
+        auto owned = base(); auto &r = *owned;
+        r.add_relic(RelicId::PEN_NIB); r.add_relic(RelicId::BLACK_BLOOD); r.add_relic(RelicId::BURNING_BLOOD);
+        check("First Starter fallback obtains", r.add_relic(RelicId::TOUCH_OF_OROBAS));
+        check("BlackBlood is the first Starter and refines to Circlet", r.relics[1] == static_cast<int>(RelicId::CIRCLET));
+        check("Later BurningBlood remains in place", r.relics[2] == static_cast<int>(RelicId::BURNING_BLOOD));
+    }
+    for (bool queued : {false, true}) {
+        auto owned = base(); auto &r = *owned;
+        r.add_relic(RelicId::PEN_NIB);
+        if (queued) r.cardGrid.kind = 6;
+        const auto before = r.serialize();
+        check("Missing Starter is unavailable before queueing", !r.add_relic(RelicId::TOUCH_OF_OROBAS));
+        check("Missing Starter rejection is atomic", r.serialize() == before);
+    }
+    {
+        auto owned = base(); auto &r = *owned;
+        r.add_relic(RelicId::PEN_NIB); r.add_relic(RelicId::BURNING_BLOOD); r.add_relic(RelicId::HAPPY_FLOWER);
+        r.hp = 30; r.relicAux[0] = 7; r.relicAux[1] = 91; r.relicAux[2] = 2;
+        check("Replacement traverses obtain hook", r.replace_starter_relic(1, RelicId::STRAWBERRY));
+        check("Native Strawberry acquisition HP effect", r.hp == 37 && r.maxHp == 87);
+        check("Replacement obtains at original index", r.relicCount == 3 && r.relics[1] == static_cast<int>(RelicId::STRAWBERRY));
+        check("Replacement resets only original state", r.relicAux[0] == 7 && r.relicAux[1] == 0 && r.relicAux[2] == 2);
+        check("Replacement removes obtained relic from both bags", !bag_contains(r.playerRelicBag, RelicId::STRAWBERRY) && !bag_contains(r.sharedRelicBag, RelicId::STRAWBERRY));
+        const auto before = r.serialize();
+        check("Helper rejects non-Starter source", !r.replace_starter_relic(1, RelicId::PEAR));
+        check("Helper invalid index rejects", !r.replace_starter_relic(-1, RelicId::PEAR));
+        check("Rejected replacements are atomic", r.serialize() == before);
+    }
+    {
+        auto owned = base(); auto &r = *owned;
+        r.relicCount = MAX_RELICS - 1;
+        std::fill(std::begin(r.relics), std::end(r.relics), static_cast<int>(RelicId::CIRCLET));
+        r.relics[3] = static_cast<int>(RelicId::BURNING_BLOOD);
+        check("Full-after-Touch inventory replaces without extra capacity", r.add_relic(RelicId::TOUCH_OF_OROBAS));
+        check("Full inventory replacement retains index and count", r.relicCount == MAX_RELICS && r.relics[3] == static_cast<int>(RelicId::BLACK_BLOOD));
+    }
+    {
+        auto owned = base(); auto &r = *owned;
+        r.add_relic(RelicId::PEN_NIB); r.add_relic(RelicId::BURNING_BLOOD);
+        r.add_relic(RelicId::HAPPY_FLOWER); r.add_relic(RelicId::LIZARD_TAIL);
+        r.relicAux[0] = 7; r.relicAux[2] = 1; r.relicAux[3] = 1;
+        r.add_relic(RelicId::TOUCH_OF_OROBAS);
+        r.begin_combat(Encounter::INVALID);
+        check("Combat preserves PenNib association", r.battle.relics[0] == static_cast<int>(RelicId::PEN_NIB) && r.battle.relicAux[0] == 7);
+        check("Combat advances the correct HappyFlower counter", r.battle.relics[2] == static_cast<int>(RelicId::HAPPY_FLOWER) && r.battle.relicAux[2] == 2);
+        check("Combat preserves used LizardTail state", r.battle.relics[3] == static_cast<int>(RelicId::LIZARD_TAIL) && r.battle.relicAux[3] == 1);
+        r.sync_relics_from_battle();
+        check("Combat-to-run counters remain aligned", r.relicAux[0] == 7 && r.relicAux[2] == 2 && r.relicAux[3] == 1);
+    }
+    // Toy Box's overall native rule is still unsupported. This checks only the
+    // shared ID/counter storage invariant of its existing deletion path.
+    for (std::uint64_t seed : {0, 42, 123}) {
+        auto owned = base(); auto &r = *owned;
+        const RelicId ids[] = {RelicId::BURNING_BLOOD, RelicId::PEN_NIB, RelicId::HAPPY_FLOWER, RelicId::LIZARD_TAIL, RelicId::TOY_BOX};
+        const int aux[] = {0, 7, 2, 1, 0};
+        r.relicCount = 5; r.toyBoxCombats = 2; r.runRng[RNG_NICHE] = Rng(seed);
+        for (int i = 0; i < 5; ++i) { r.relics[i] = static_cast<int>(ids[i]); r.relicAux[i] = aux[i]; }
+        auto expectedRng = r.runRng[RNG_NICHE]; const int drop = 1 + expectedRng.next_int(0, 2);
+        relics_combat_end(r, true, false);
+        check("Existing deletion changes count once", r.relicCount == 4);
+        for (int i = 0, j = 0; i < 5; ++i) if (i != drop) {
+            check("Deletion retains surviving ID/counter pairs", r.relics[j] == static_cast<int>(ids[i]) && r.relicAux[j] == aux[i]); ++j;
+        }
+        check("Deletion clears unused slot", r.relics[4] == 0 && r.relicAux[4] == 0);
+        check("Storage fix adds no RNG draws", r.runRng[RNG_NICHE].counter == expectedRng.counter);
+        r.relicAux[4] = 99;
+        check("New acquisition resets stale unused state", r.add_relic(RelicId::ANCHOR) && r.relicAux[4] == 0);
+    }
+    std::cout << "native step1 relic replacement: " << checks << " checks, " << failures << " failures\n";
+    return failures ? 1 : 0;
+}
diff --git a/simulator/tests/native_step1_self_damage.cpp b/simulator/tests/native_step1_self_damage.cpp
new file mode 100644
--- /dev/null
+++ b/simulator/tests/native_step1_self_damage.cpp
@@ -0,0 +1,129 @@
+// Actual v0.111.0 DLL fixture outcomes; see native-round4-step1-card-fixtures.
+// Covers the two powers and their relative order, not general hook ordering.
+#include <cmath>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <nlohmann/json.hpp>
+#include "sts2/battle.h"
+#include "sts2/relics.h"
+using namespace sts2;
+using json = nlohmann::json;
+namespace {
+int checks=0, failures=0;
+void check(const std::string &label, double got, double want) {
+    ++checks;
+    if (std::abs(got-want)>1e-10) { ++failures;std::cout<<label<<": got="<<got<<" native="<<want<<" FAIL\n"; }
+}
+BattleContext base(int enemies) {
+    BattleContext b;
+    Card deck[1]={make_card(CardId::DEFEND_IRONCLAD,false,1)};
+    b.init(Encounter::SETUP_CEREMONIAL_BEAST_BOSS,1234,deck,1,0,80,80);
+    b.handCount=b.drawCount=b.discardCount=b.exhaustCount=b.knownTopCount=0;
+    b.relicCount=0;b.player.energy=10;
+    b.monsterCount=enemies;
+    for(int i=0;i<enemies;++i) {
+        b.monsters[i]=Monster{};
+        b.monsters[i].id=MonsterId::CALCIFIED_CULTIST;
+        b.monsters[i].slot=i;
+        b.monsters[i].hp=b.monsters[i].maxHp=10000;
+    }
+    return b;
+}
+CardId cardId(const std::string &id) {return id=="INFERNO"?CardId::INFERNO_CARD:CardId::CRIMSON_MANTLE;}
+PowerId powerId(const std::string &id) {return id=="INFERNO"?PowerId::INFERNO:PowerId::CRIMSON_MANTLE;}
+void play(BattleContext &b,const std::string &id,int count,bool upgraded=false) {
+    b.hand[b.handCount]=make_card(cardId(id),upgraded,b.require_card_uid());
+    b.hand[b.handCount].replay=count-1;
+    Action a;a.type=ActionType::PLAY_CARD;a.hand=b.handCount++;a.target=0;
+    check(id+" replay card accepted",b.step(a),true);
+}
+void modifier(BattleContext &b,const std::string &m) {
+    b.add_player_power(PowerId::RUPTURE,2);
+    if(m.find("tungsten")!=std::string::npos)b.relics[b.relicCount++]=int(RelicId::TUNGSTEN_ROD);
+    if(m.find("buffer")!=std::string::npos)b.add_player_power(PowerId::BUFFER,1);
+    if(m=="intangible")b.add_player_power(PowerId::INTANGIBLE,1);
+    if(m=="revive") {b.relics[b.relicCount++]=int(RelicId::LIZARD_TAIL);b.player.hp=1;}
+    if(m=="lethal")b.player.hp=1;
+}
+void state(const std::string &label,const BattleContext &b,const json &s) {
+    check(label+" hp",b.player.hp,s["hp"]);
+    check(label+" block",b.player.block,s["block"]);
+    check(label+" lizard spent",relic_aux(b,RelicId::LIZARD_TAIL)>0,s["lizardUsed"].get<bool>());
+    for(int i=0;i<b.monsterCount;++i)check(label+" enemy "+std::to_string(i),10000-b.monsters[i].hp,s["damage"][i]);
+    // Native death tears down every power; the existing simulator retains its
+    // final combat values. Compare lethal effects and outcome, not that global
+    // teardown representation (outside this two-power state change).
+    if(s["hp"]==0) {check(label+" terminal loss",b.outcome==Outcome::PLAYER_LOSS,true);return;}
+    check(label+" strength",b.player.strength,s["strength"]);
+    check(label+" buffer",b.player_power(PowerId::BUFFER),s["buffer"]);
+    check(label+" crimson amount",b.player_power(PowerId::CRIMSON_MANTLE),s["crimsonAmount"]);
+    check(label+" inferno amount",b.player_power(PowerId::INFERNO),s["infernoAmount"]);
+    check(label+" crimson self",b.player.crimsonMantleSelfDamage,s["crimsonSelf"]);
+    check(label+" inferno self",b.player.infernoSelfDamage,s["infernoSelf"]);
+    if(b.player_power(PowerId::CRIMSON_MANTLE)>0&&b.player_power(PowerId::INFERNO)>0) {
+        const auto &powers=s["powers"];
+        auto c=std::find(powers.begin(),powers.end(),"CRIMSON_MANTLE_POWER");
+        auto in=std::find(powers.begin(),powers.end(),"INFERNO_POWER");
+        check(label+" power order",b.player.infernoBeforeCrimsonMantle,in<c);
+    }
+}
+}
+int main() {
+    const auto root=std::filesystem::path(__FILE__).parent_path().parent_path().parent_path();
+    json fixtures;std::ifstream(root/"native-round4-step1-card-fixtures/results.json")>>fixtures;
+    check("native fixture completed",fixtures["status"]=="completed",true);
+    check("target DLL hash",fixtures["gameAssemblySha256"]=="9cb4f1ad8c9f284aa8fec3122ffd6d780bbf543d875c817abdd12ff63fbf12b4",true);
+    for(const auto &f:fixtures["results"]) {
+        const std::string t=f["test"];
+        const auto &initial=f.contains("before")?f["before"]:f["after"];
+        auto b=base(initial["damage"].size());
+        if(t=="stack") {
+            const std::string id=f["id"];const int n=f["count"];const bool up=f["upgraded"];
+            const std::string label=id+(up?"+":"")+" x"+std::to_string(n);
+            play(b,id,n,up);modifier(b,"none");state(label+" applied",b,f["before"]);
+            b.start_player_turn();state(label+" first",b,f["first"]);
+            b.start_player_turn();state(label+" second",b,f["second"]);
+        } else if(t=="modifier") {
+            const std::string id=f["id"],m=f["modifier"];
+            play(b,id,f["count"]);modifier(b,m);state(id+" "+m+" before",b,f["before"]);
+            b.start_player_turn();state(id+" "+m+" after",b,f["after"]);
+        } else if(t=="order") {
+            const bool inFirst=f["infernoFirst"];const std::string m=f["modifier"];
+            play(b,inFirst?"INFERNO":"CRIMSON_MANTLE",inFirst?3:1);
+            play(b,inFirst?"CRIMSON_MANTLE":"INFERNO",inFirst?1:3);
+            modifier(b,m);const std::string label=(inFirst?"Inferno first ":"Crimson first ")+m;
+            state(label+" before",b,f["before"]);
+            b.start_player_turn();state(label+" after",b,f["after"]);
+        } else if(t=="damage_trigger") {
+            const std::string mode=f["mode"];play(b,"INFERNO",2);modifier(b,"none");
+            if(mode=="enemy_damage")b.inMonsterTurn=true;
+            if(mode=="direct_hp")b.lose_hp(3);
+            else {if(mode=="blocked")b.player.block=10;b.damage_player(3,mode!="blocked");}
+            state(mode,b,f["after"]);
+        } else if(t=="direct_apply"||t=="remove_reapply") {
+            const std::string id=f["id"];const auto power=powerId(id);
+            b.add_player_power(power,13);b.start_player_turn();
+            if(t=="remove_reapply") {
+                play(b,id,2);state(id+" before removal",b,f["before"]);
+                b.add_player_power(power,-b.player_power(power));
+                b.add_player_power(power,13);
+            }
+            state(t+" "+id,b,f["after"]);
+        } else {check("known native fixture",false,true);}
+    }
+    // Amount changes from other effects neither increment nor reset SelfDamage.
+    auto b=base(1);play(b,"INFERNO",3);play(b,"CRIMSON_MANTLE",2);
+    b.add_player_power(PowerId::INFERNO,5);b.add_player_power(PowerId::CRIMSON_MANTLE,-1);
+    check("raw amount increase preserves counter",b.player.infernoSelfDamage,3);
+    check("partial decrement preserves counter",b.player.crimsonMantleSelfDamage,2);
+    check("raw amount update preserves order",b.player.infernoBeforeCrimsonMantle,true);
+    b.add_player_power(PowerId::INFERNO,-b.player_power(PowerId::INFERNO));
+    check("removal clears inferno counter",b.player.infernoSelfDamage,0);
+    play(b,"INFERNO",1);
+    check("recreated inferno now second",b.player.infernoBeforeCrimsonMantle,false);
+    check("recreated inferno starts at one",b.player.infernoSelfDamage,1);
+    std::cout<<"Native step1 self damage: "<<fixtures["results"].size()<<" fixtures, "<<checks<<" checks, "<<failures<<" failures\n";
+    return failures?1:0;
+}
diff --git a/simulator/tests/native_step1_state_contract.cpp b/simulator/tests/native_step1_state_contract.cpp
new file mode 100644
--- /dev/null
+++ b/simulator/tests/native_step1_state_contract.cpp
@@ -0,0 +1,92 @@
+// The self-damage rule state must survive search clones / snapshots and remain
+// public without disclosing hidden RNG state or draw order.
+#include "sts2/observe.h"
+#include <algorithm>
+#include <cassert>
+#include <cstddef>
+#include <cstring>
+#include <iostream>
+#include <memory>
+
+using namespace sts2;
+
+static void rejects_atomically(const std::string &blob, RunContext &out) {
+    const auto before = out.serialize();
+    assert(!RunContext::restore(blob, out));
+    assert(out.serialize() == before);
+}
+
+int main() {
+    auto source = std::make_unique<RunContext>();
+    source->init(42, 0);
+    source->screen = RunScreen::COMBAT;
+    source->inBattle = true;
+    source->battle.init(Encounter::SETUP_CEREMONIAL_BEAST_BOSS, 42,
+                       source->deck, source->deckCount, 0, 80, 80);
+    auto &b = source->battle;
+    b.add_player_power(PowerId::INFERNO, 18);
+    b.add_player_power(PowerId::CRIMSON_MANTLE, 17);
+    b.player.crimsonMantleSelfDamage = 2;
+    b.player.infernoSelfDamage = 3;
+    b.player.infernoBeforeCrimsonMantle = true;
+    const auto observation = public_combat_observation(b);
+    assert(observation.size() == PUBLIC_COMBAT_OBS_DIM);
+    assert(observation[observation.size()-3] == 0.2f);
+    assert(observation[observation.size()-2] == 0.3f);
+    assert(observation.back() == 1.0f);
+    const auto runObservation = public_observation(*source);
+    assert(runObservation.size() == PUBLIC_OBS_DIM);
+    assert(std::equal(observation.begin(), observation.end(),
+                      runObservation.begin()+PUBLIC_RUN_DIM));
+
+    for (int field = 0; field < 3; ++field) {
+        BattleContext distinct = b;
+        if (field == 0) ++distinct.player.crimsonMantleSelfDamage;
+        if (field == 1) ++distinct.player.infernoSelfDamage;
+        if (field == 2) distinct.player.infernoBeforeCrimsonMantle = false;
+        const auto different = public_combat_observation(distinct);
+        assert(different != observation);
+        assert(std::equal(observation.begin(), observation.end()-3, different.begin()));
+    }
+    for (unsigned seed = 0; seed < 32; ++seed) {
+        BattleContext sampled = b;
+        sampled.resample_hidden(seed);
+        assert(public_combat_observation(sampled) == observation);
+    }
+
+    auto restored = std::make_unique<RunContext>();
+    const auto blob = source->serialize();
+    assert(static_cast<unsigned char>(blob[4]) == 8);
+    assert(RunContext::restore(blob, *restored));
+    assert(restored->serialize() == blob);
+    assert(public_observation(*restored) == runObservation);
+    auto copied = std::make_unique<RunContext>(*source);
+    source->battle.start_player_turn();
+    restored->battle.start_player_turn();
+    copied->battle.start_player_turn();
+    assert(public_combat_observation(source->battle) == public_combat_observation(restored->battle));
+    assert(public_combat_observation(source->battle) == public_combat_observation(copied->battle));
+
+    auto old = blob; old[4] = 7;
+    rejects_atomically(old, *restored);
+    const auto playerOffset = 12 + reinterpret_cast<const char *>(&source->battle.player)
+                                - reinterpret_cast<const char *>(source.get());
+    for (auto offset : {offsetof(Player, crimsonMantleSelfDamage), offsetof(Player, infernoSelfDamage)}) {
+        for (int invalid : {-1, 10000001}) {
+            auto bad = blob;
+            std::memcpy(bad.data()+playerOffset+offset, &invalid, sizeof(invalid));
+            rejects_atomically(bad, *restored);
+        }
+    }
+    auto badBool = blob;
+    badBool[playerOffset+offsetof(Player, infernoBeforeCrimsonMantle)] = 2;
+    rejects_atomically(badBool, *restored);
+
+    // Starting the next combat cannot retain a prior battle's power state.
+    b.init(Encounter::SETUP_CEREMONIAL_BEAST_BOSS, 43,
+           source->deck, source->deckCount, 0, 80, 80);
+    assert(b.player.crimsonMantleSelfDamage == 0 && b.player.infernoSelfDamage == 0);
+    assert(!b.player.infernoBeforeCrimsonMantle);
+    std::cout << "step1 state contract: public counters/order, 32 resamplings, clone/restore continuation, "
+                 "old version and malformed state rejection, new-combat reset passed\n";
+}
