+    Random randomFromSnapshot(const py::dict &src) {
+        Random rng;
+        rng.seed0 = py::cast<std::uint64_t>(src["seed0"]);
+        rng.seed1 = py::cast<std::uint64_t>(src["seed1"]);
+        rng.counter = py::cast<std::int32_t>(src["counter"]);
+        return rng;
+    }
