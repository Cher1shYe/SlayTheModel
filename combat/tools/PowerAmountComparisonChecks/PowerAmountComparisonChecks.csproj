<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../local.props" Condition="Exists('../../local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Runtime/PowerAmountComparisonPatch.cs" Link="PowerAmountComparisonPatch.cs" />
    <Reference Include="STS2-RitsuLib" HintPath="$(RitsuLibDir)/STS2-RitsuLib.dll" />
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" />
  </ItemGroup>
  <Target Name="ValidateReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll') or !Exists('$(RitsuLibDir)/STS2-RitsuLib.dll')" Text="请通过 local.props 或 -p:Sts2DataDir=... -p:RitsuLibDir=... 指定当前游戏与 RitsuLib。" />
  </Target>
</Project>
