[Unit]
Description=Combat Solver online presence
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/combatsolver-presence
EnvironmentFile=%h/combatsolver-presence/private/service.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/combatsolver-presence/data
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=default.target
