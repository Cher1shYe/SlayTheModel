// TEMPORARY SPIKE — validates whether the engine's combat state can be cloned.
// Not part of the project; remove after the experiment.
using System.Collections;
using System.Diagnostics;
using System.Reflection;
using System.Runtime.CompilerServices;
using MegaCrit.Sts2.Core.Combat;
using MegaCrit.Sts2.Core.Entities.Multiplayer;
using MegaCrit.Sts2.Core.Runs;

namespace Sts2Headless;

public static class CloneProbe
{
    static Dictionary<object, object> _memo;
    static int _copied, _shared, _depthGuard;

    static bool Share(Type t)
    {
        if (t.IsPrimitive || t.IsEnum || t == typeof(string) || t == typeof(decimal) ||
            t == typeof(Type) || typeof(Delegate).IsAssignableFrom(t) || t.IsPointer)
            return true;
        var ns = t.Namespace ?? "";
        // Model singletons / per-instance mutable clones live in a global registry: never copy them.
        if (ns.StartsWith("MegaCrit.Sts2.Core.Models")) return true;
        if (ns.StartsWith("Godot")) return true;
        if (t == typeof(object)) return true;
        return false;
    }

    static object Copy(object o)
    {
        if (o is null) return null;
        var t = o.GetType();
        if (Share(t)) { _shared++; return o; }
        if (_memo.TryGetValue(o, out var hit)) return hit;

        if (t.IsArray)
        {
            var arr = (Array)o;
            var et = t.GetElementType();
            if (Share(et)) { _shared++; return o; }
            var dst = Array.CreateInstance(et, arr.Length);
            _memo[o] = dst; _copied++;
            for (int i = 0; i < arr.Length; i++) dst.SetValue(Copy(arr.GetValue(i)), i);
            return dst;
        }

        if (t.IsGenericType)
        {
            var gtd = t.GetGenericTypeDefinition();
            if (gtd == typeof(List<>) || gtd == typeof(IList<>) || gtd == typeof(IReadOnlyList<>))
            {
                var et = t.GetGenericArguments()[0];
                var dst = (IList)Activator.CreateInstance(typeof(List<>).MakeGenericType(et));
                _memo[o] = dst; _copied++;
                foreach (var x in (IEnumerable)o) dst.Add(Copy(x));
                return dst;
            }
            if (gtd == typeof(HashSet<>))
            {
                var dst = Activator.CreateInstance(t);
                _memo[o] = dst; _copied++;
                var add = t.GetMethod("Add");
                foreach (var x in (IEnumerable)o) add.Invoke(dst, new[] { Copy(x) });
                return dst;
            }
            if (gtd == typeof(Dictionary<,>))
            {
                var dst = Activator.CreateInstance(t);
                _memo[o] = dst; _copied++;
                var idx = t.GetProperty("Item");
                foreach (DictionaryEntry e in (IDictionary)o)
                    idx.SetValue(dst, Copy(e.Value), new[] { Copy(e.Key) });
                return dst;
            }
        }

        if (t.IsAbstract || t.IsInterface) { _shared++; return o; }
        if (++_depthGuard > 4000) { _depthGuard--; _shared++; return o; }

        object inst;
        try { inst = RuntimeHelpers.GetUninitializedObject(t); }
        catch { _depthGuard--; _shared++; return o; }
        _memo[o] = inst; _copied++;

        for (var cur = t; cur != null && cur != typeof(object); cur = cur.BaseType)
            foreach (var f in cur.GetFields(BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.DeclaredOnly))
            {
                if (f.IsStatic || f.IsLiteral) continue;
                object v;
                try { v = f.GetValue(o); } catch { continue; }
                if (v is null) continue;
                // NOTE: always assign. Copy() returns the same reference for shared (model) types,
                // so skipping the assignment here would leave the clone's field null.
                try { f.SetValue(inst, Copy(v)); } catch { _shared++; }
            }
        _depthGuard--;
        return inst;
    }

    static string Describe(CombatState c)
    {
        var parts = new List<string>();
        foreach (var cr in c.Creatures)
        {
            try
            {
                var pw = cr.Powers == null ? "" : " [" + string.Join(",", cr.Powers.Select(p => p.Id + "x" + p.Amount)) + "]";
                parts.Add(cr.Name + " hp=" + cr.CurrentHp + "/" + cr.MaxHp + " blk=" + cr.Block + " side=" + cr.Side + pw);
            }
            catch (Exception ex) { parts.Add("<describe failed: " + ex.GetType().Name + ">"); }
        }
        return "round=" + c.RoundNumber + " side=" + c.CurrentSide + " :: " + string.Join(" | ", parts);
    }

    public static Dictionary<string, object?> Run()
    {
        var res = new Dictionary<string, object?>();
        var combat = CombatManager.Instance.DebugOnlyGetState();
        if (combat == null) { res["type"] = "error"; res["message"] = "no combat in progress"; return res; }
        var runState = combat.RunState;
        if (runState == null) { res["type"] = "error"; res["message"] = "no run state"; return res; }

        res["live"] = Describe(combat);
        res["creature_count"] = combat.Creatures.Count;

        // --- 1. the engine's own "full combat state" capture (multiplayer resync path) ---
        var sw = Stopwatch.StartNew();
        NetFullCombatState net = null;
        string netErr = null;
        try { net = NetFullCombatState.FromRun(runState, null); }
        catch (Exception ex) { netErr = ex.GetType().Name + ": " + ex.Message; }
        sw.Stop();
        res["net_capture_ms"] = Math.Round(sw.Elapsed.TotalMilliseconds, 3);
        if (net != null)
        {
            res["net_creatures"] = net.Creatures?.Count;
            res["net_players"] = net.Players?.Count;
            if (net.Players != null && net.Players.Count > 0)
            {
                var p0 = net.Players[0];
                if (p0.piles != null)
                {
                    res["net_p0_piles"] = p0.piles.Count;
                    foreach (var pile in p0.piles)
                        res["net_pile_" + pile.pileType] = pile.cards == null ? 0 : pile.cards.Count;
                }
            }
        }
        else res["net_error"] = netErr;

        // --- 2. reflection deep-clone of the live CombatState graph ---
        _memo = new Dictionary<object, object>(ReferenceEqualityComparer.Instance);
        _copied = 0; _shared = 0; _depthGuard = 0;
        sw.Restart();
        object clone = null;
        string cloneErr = null;
        try { clone = Copy(combat); }
        catch (Exception ex) { cloneErr = ex.GetType().Name + ": " + ex.Message; }
        sw.Stop();
        res["clone_ms"] = Math.Round(sw.Elapsed.TotalMilliseconds, 3);
        res["clone_objects_copied"] = _copied;
        res["clone_objects_shared"] = _shared;
        if (cloneErr != null) res["clone_error"] = cloneErr;

        // warm measurements: JIT + warm caches
        const int N = 30;
        for (int i = 0; i < 5; i++) { _memo = new Dictionary<object, object>(ReferenceEqualityComparer.Instance); Copy(combat); }
        sw.Restart();
        for (int i = 0; i < N; i++) { _memo = new Dictionary<object, object>(ReferenceEqualityComparer.Instance); Copy(combat); }
        sw.Stop();
        res["clone_warm_ms"] = Math.Round(sw.Elapsed.TotalMilliseconds / N, 3);
        res["clones_per_sec_warm"] = Math.Round(1000.0 / (sw.Elapsed.TotalMilliseconds / N), 1);

        try
        {
            for (int i = 0; i < 3; i++) NetFullCombatState.FromRun(runState, null);
            sw.Restart();
            for (int i = 0; i < N; i++) NetFullCombatState.FromRun(runState, null);
            sw.Stop();
            res["net_capture_warm_ms"] = Math.Round(sw.Elapsed.TotalMilliseconds / N, 3);
        }
        catch (Exception ex) { res["net_warm_error"] = ex.GetType().Name; }

        if (clone is CombatState cc)
        {
            res["clone"] = Describe(cc);
            res["clone_matches"] = Describe(cc) == Describe(combat);
            bool sharedCreature = false;
            for (int i = 0; i < Math.Min(cc.Creatures.Count, combat.Creatures.Count); i++)
                if (ReferenceEquals(cc.Creatures[i], combat.Creatures[i])) sharedCreature = true;
            res["clone_shares_creature_instances"] = sharedCreature;

            // mutate the ORIGINAL, confirm the CLONE does not follow
            try
            {
                var cr = combat.Creatures[0];
                int before = cc.Creatures[0].CurrentHp;
                var f = typeof(MegaCrit.Sts2.Core.Entities.Creatures.Creature)
                        .GetField("_currentHp", BindingFlags.NonPublic | BindingFlags.Instance);
                if (f != null)
                {
                    f.SetValue(cr, before - 7);
                    int after = cc.Creatures[0].CurrentHp;
                    res["original_mutated_to"] = before - 7;
                    res["clone_after_original_mutation"] = after;
                    res["clone_is_independent"] = after == before;
                    f.SetValue(cr, before); // restore
                }
                else res["independence_test"] = "could not find _currentHp field";
            }
            catch (Exception ex) { res["independence_test"] = ex.GetType().Name + ": " + ex.Message; }
        }

        res["type"] = "clone_probe";
        return res;
    }
}
