+                $"Player {PlayerId} has invalid persistent HP or gold.");
+        }
+
+        foreach (var card in Deck)
+        {
+            card.Validate();
+        }
+
+        var deckIndices = Deck.Select(card => card.DeckIndex).Order().ToArray();
+        if (!deckIndices.SequenceEqual(Enumerable.Range(0, Deck.Count)))
+        {
