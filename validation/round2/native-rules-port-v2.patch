+                  _id(context['second_boss_encounter_id'], 'ENCOUNTER', self.encounter_ids)
+                  if context.get('second_boss_encounter_id') else 0]
+        vector = sum((_one(acts[x], 4) for x in act_ids), []) + _one(golden + 1, 4) + [unknown / 30]
+        vector += [float(context['apply_discovery_order']), runs / 100]
