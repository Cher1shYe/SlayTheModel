+        r=start("DOORS_OF_LIGHT_AND_DARK");assert(r.step({RunActionType::EVENT_CHOICE,0}));
+        int up=0;for(int i=0;i<r.deckCount;++i)up+=r.deck[i].upgraded;assert(up==2&&r.eventRng.counter==9);
+    }
+    {
