+        if any(type(context.get(k)) is not bool for k in names):
+            raise Unsupported('missing native unlock/discovery flags')
+        seen_ids = context.get('seen_encounter_ids')
+        if not isinstance(seen_ids, list) or len(set(seen_ids)) != len(seen_ids):
