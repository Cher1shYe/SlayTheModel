+        cost = obj.get('current_energy_cost')
+        amount, disabled = obj.get('enchantment_amount'), obj.get('enchantment_disabled')
+        if any(type(x) is not int for x in (guilt, cost, amount)) or type(disabled) is not bool:
+            raise Unsupported('deck card lacks exact cost/guilty/enchantment facts')
+        if not 0 <= guilt <= 5 or cost < -1 or amount < 0:
+            raise Unsupported('invalid native card state')
+        ench = _id(obj['enchantment_id'], 'ENCHANTMENT', self.enchantments) if obj.get('enchantment_id') else 0
+        if not ench and (amount or disabled):
