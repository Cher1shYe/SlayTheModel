+    private static bool TryClaimPendingOutsideAction(PendingOutsideAction expected)
+    {
+        lock (PendingActionGate)
+        {
+            if (!ReferenceEquals(_pendingOutsideAction, expected))
+            {
+                return false;
+            }
+
+            _pendingOutsideAction = null;
+            return true;
+        }
+    }
